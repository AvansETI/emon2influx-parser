# emon2influx-parser configuration. Copy to .env and fill in. Never commit .env.

# --- MQTT (source) ---
MQTT_HOST=
MQTT_PORT=1883
MQTT_TOPIC=smartmeter/raw
MQTT_USERNAME=
MQTT_PASSWORD=
# Unique per running instance (production and dev must differ)
MQTT_CLIENT_ID=emon2influx-parser
MQTT_QOS=1
# Use TLS for the broker connection (true/false)
MQTT_TLS=false

# --- InfluxDB (target) ---
# Dev server: https://influxdb.sendlab.nl; production: the local IP address
INFLUX_URL=
INFLUX_ORG=
# Production: p1-smartmeters. Dev/test: a separate bucket, e.g. p1-smartmeters-test
INFLUX_BUCKET=
# Token with write access to INFLUX_BUCKET only
INFLUX_TOKEN=
INFLUX_MEASUREMENT=dsmr
# Points per write and maximum wait before a write (ms)
INFLUX_BATCH_SIZE=500
INFLUX_FLUSH_INTERVAL_MS=1000

# Paths below (SPOOL_DIR, LOG_DIR, QUARANTINE_FILE, HEALTH_FILE) are for development; on the
# LXC the systemd service sets them, so install.sh leaves them out of /etc/emon2influx-parser/env.

# Write-ahead spool for when InfluxDB is unreachable
SPOOL_DIR=spool
# Maximum spool size; when full, the oldest points are dropped (logged)
SPOOL_MAX_MB=2048

# --- Parsing ---
# Accepted signature prefixes, comma-separated. Each needs a payload decoder
# (V02 is added when its payload format is known)
SIGNATURE_PREFIXES=2019-ETI-EMON-V01
# false: telegrams with a wrong CRC are written with crc_valid=false and counted.
# true: they are rejected. (Meters before DSMR 4 send no CRC.)
REQUIRE_VALID_CRC=false

# --- Run mode ---
# write = write to InfluxDB; dry-run = parse and log only
MODE=dry-run

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs
# Keep this many hourly log files
LOG_KEEP=48
# Raw messages of failed parses (JSON Lines, EAN codes removed)
QUARANTINE_FILE=logs/quarantine.jsonl
# Log each kind of error per kit in full this many times per hour, then count only
ERROR_LOG_LIMIT_PER_HOUR=5

# Status for the updater's health check, rewritten every 30 s (empty: off)
HEALTH_FILE=health.json
