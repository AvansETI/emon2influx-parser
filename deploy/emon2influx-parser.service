# systemd unit for emon2influx-parser (doc/architecture.md §11).
# Installed by deploy/install.sh and kept up to date by emon2influx-update.
[Unit]
Description=emon2influx-parser: P1 telegrams from MQTT to InfluxDB
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=emon2influx
Group=emon2influx
EnvironmentFile=/etc/emon2influx-parser/env
WorkingDirectory=/var/lib/emon2influx-parser
ExecStart=/opt/emon2influx-parser/current/venv/bin/python -m emon2influx --env-file /dev/null
# Spool, state and health survive restarts; logs go to journald and to LOG_DIR.
StateDirectory=emon2influx-parser
LogsDirectory=emon2influx-parser
Environment=SPOOL_DIR=/var/lib/emon2influx-parser/spool
Environment=HEALTH_FILE=/var/lib/emon2influx-parser/health.json
Environment=LOG_DIR=/var/log/emon2influx-parser
Environment=QUARANTINE_FILE=/var/log/emon2influx-parser/quarantine.jsonl
Restart=always
RestartSec=5
# Time to drain the queue and flush the last batch to InfluxDB or the spool.
TimeoutStopSec=45

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
