#!/usr/bin/env bash
# emon2influx-update: installs a new release of emon2influx-parser when one is published, with a
# health check and automatic rollback (doc/architecture.md §11.1). Runs as root from
# emon2influx-update.service, started every minute by emon2influx-update.timer.
#
#   emon2influx-update                       check now and install a new release
#   emon2influx-update --rollback            back to the previous release (the current one is
#                                            then recorded as bad, so it is not reinstalled)
#   emon2influx-update --dry-run --manifest FILE --package FILE
#                                            install a local package without switching services
#                                            (CI); combine with E2I_APP_DIR etc. to use a temp root
#
# It reads the release download link, not the GitHub API: unauthenticated API calls are limited
# to 60 per hour per IP address, shared with other updaters on the same network.
set -euo pipefail

REPO="${E2I_REPO:-AvansETI/emon2influx-parser}"
RELEASE_TAG="${E2I_RELEASE_TAG:-main-latest}"
BASE_URL="${E2I_BASE_URL:-https://github.com/$REPO/releases/download/$RELEASE_TAG}"
APP_DIR="${E2I_APP_DIR:-/opt/emon2influx-parser}"
STATE_DIR="${E2I_STATE_DIR:-/var/lib/emon2influx-parser}"
ENV_FILE="${E2I_ENV_FILE:-/etc/emon2influx-parser/env}"
SERVICE="${E2I_SERVICE:-emon2influx-parser}"
HEALTH_FILE="${E2I_HEALTH_FILE:-$STATE_DIR/health.json}"
HEALTH_TIMEOUT="${E2I_HEALTH_TIMEOUT:-90}"
SYSTEMD_DIR="${E2I_SYSTEMD_DIR:-/etc/systemd/system}"
SCRIPT_PATH="${E2I_SCRIPT_PATH:-/usr/local/sbin/emon2influx-update}"
KEEP=3

UPDATE_DIR="$STATE_DIR/update"
BAD_FILE="$UPDATE_DIR/bad-releases"
CONFIG_REJECTED="$UPDATE_DIR/config-rejected"

mode=update
local_manifest=""
local_package=""
while [ $# -gt 0 ]; do
  case "$1" in
    --rollback) mode=rollback ;;
    --dry-run) mode=dry-run ;;
    --manifest) local_manifest="$2"; shift ;;
    --package) local_package="$2"; shift ;;
    -h | --help) sed -n '2,15p' "$0"; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

log() { echo "emon2influx-update: $*"; }
die() { echo "emon2influx-update: error: $*" >&2; exit 1; }

mkdir -p "$UPDATE_DIR" "$APP_DIR/releases"
touch "$BAD_FILE"
exec 9>"$UPDATE_DIR/lock"
flock -n 9 || { log "another update is running"; exit 0; }

workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT

json() { python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))[sys.argv[2]])' "$1" "$2"; }

current_sha() {
  local target
  target="$(readlink "$APP_DIR/current" 2>/dev/null || true)"
  [ -n "$target" ] && basename "$target"
  return 0
}

previous_sha() {
  local current
  current="$(current_sha)"
  find "$APP_DIR/releases" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %f\n' |
    sort -rn | awk -v cur="$current" '$2 != cur {print $2; exit}'
}

switch_to() {
  ln -sfn "releases/$1" "$APP_DIR/current.new"
  mv -Tf "$APP_DIR/current.new" "$APP_DIR/current"
}

systemd() { [ "$mode" = dry-run ] || systemctl "$@"; }

# Healthy: active, health.json of this release updated in the last minute, MQTT connected and at
# least one message processed. An InfluxDB outage does not count: the spool keeps the data.
healthy() {
  local sha="$1" deadline=$((SECONDS + HEALTH_TIMEOUT)) reason="no health file"
  while [ "$SECONDS" -lt "$deadline" ]; do
    sleep 5
    systemctl is-active --quiet "$SERVICE" || { reason="service not active"; continue; }
    reason="$(python3 - "$HEALTH_FILE" "${sha:0:7}" <<'PY'
import json, sys
from datetime import datetime, timezone
try:
    h = json.load(open(sys.argv[1]))
except (OSError, ValueError):
    print("no health file"); sys.exit()
age = (datetime.now(timezone.utc) - datetime.fromisoformat(h["updated_at"])).total_seconds()
if not str(h.get("version", "")).endswith("+" + sys.argv[2]):
    print(f"health file is from version {h.get('version')}")
elif age > 60:
    print(f"health file is {age:.0f} s old")
elif not h.get("mqtt_connected"):
    print("not connected to MQTT")
elif not h.get("messages"):
    print("no messages processed yet")
else:
    print("ok")
PY
)"
    [ "$reason" = ok ] && return 0
  done
  echo "$reason"
  return 1
}

# Unit files and this script come with each release; refresh them when they changed.
refresh_deploy_files() {
  local dir="$1" changed=0 unit
  for unit in emon2influx-parser.service emon2influx-update.service emon2influx-update.timer; do
    if [ -f "$dir/deploy/$unit" ] && ! cmp -s "$dir/deploy/$unit" "$SYSTEMD_DIR/$unit"; then
      install -m 644 "$dir/deploy/$unit" "$SYSTEMD_DIR/$unit"
      changed=1
    fi
  done
  if [ -f "$dir/deploy/emon2influx-update" ] && ! cmp -s "$dir/deploy/emon2influx-update" "$SCRIPT_PATH"; then
    # A new file and a rename: the running copy keeps reading its own (old) inode.
    install -m 755 "$dir/deploy/emon2influx-update" "$SCRIPT_PATH.new"
    mv -f "$SCRIPT_PATH.new" "$SCRIPT_PATH"
  fi
  [ "$changed" = 1 ] && systemd daemon-reload
  return 0
}

prune_releases() {
  local current
  current="$(current_sha)"
  # Keep the current release and the KEEP-1 newest others.
  find "$APP_DIR/releases" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %f\n' | sort -rn |
    awk -v cur="$current" -v keep="$KEEP" '$2 != cur && ++n >= keep {print $2}' |
    while read -r old; do rm -rf "${APP_DIR:?}/releases/$old"; done
}

if [ "$mode" = rollback ]; then
  current="$(current_sha)"
  previous="$(previous_sha)"
  [ -n "$previous" ] || die "no previous release to roll back to"
  [ -n "$current" ] && echo "$current" >>"$BAD_FILE"
  switch_to "$previous"
  touch "$APP_DIR/releases/$previous"
  systemctl restart "$SERVICE"
  if reason="$(healthy "$previous")"; then
    log "rolled back to $previous; $current is recorded as bad"
  else
    die "rolled back to $previous, but it is not healthy: $reason"
  fi
  exit 0
fi

# --- find out whether there is something new ------------------------------------------------
manifest="$workdir/manifest.json"
if [ -n "$local_manifest" ]; then
  cp "$local_manifest" "$manifest"
else
  code="$(curl -sSL --max-time 30 -w '%{http_code}' -o "$manifest" "$BASE_URL/manifest.json")" ||
    die "cannot reach $BASE_URL"
  [ "$code" = 404 ] && { log "no release published yet"; exit 0; }
  [ "$code" = 200 ] || die "manifest download answered HTTP $code"
fi

sha="$(json "$manifest" sha)"
[[ "$sha" =~ ^[0-9a-f]{40}$ ]] || die "manifest has an invalid sha"
[ "$sha" = "$(current_sha)" ] && exit 0
grep -qx -- "$sha" "$BAD_FILE" && exit 0
if [ -f "$CONFIG_REJECTED" ] && [ "$(cat "$CONFIG_REJECTED")" = "$sha $(stat -c %Y "$ENV_FILE" 2>/dev/null)" ]; then
  exit 0 # same release, same env file: it would be rejected again
fi

want_python="$(json "$manifest" python)"
have_python="$(python3 -c 'import sys; print(f"{sys.version_info[0]}.{sys.version_info[1]}")')"
[ "$want_python" = "$have_python" ] ||
  die "release $sha needs Python $want_python, this system has $have_python"

package="$workdir/package.tar.gz"
if [ -n "$local_package" ]; then
  cp "$local_package" "$package"
else
  curl -fsSL --max-time 300 -o "$package" "$BASE_URL/$(json "$manifest" package)" ||
    die "cannot download the package of $sha"
fi
echo "$(json "$manifest" sha256)  $package" | sha256sum -c --quiet - ||
  die "checksum mismatch for the package of $sha"

# --- install next to the running release ----------------------------------------------------
log "installing $(json "$manifest" version) ($sha)"
dest="$APP_DIR/releases/$sha"
rm -rf "$dest"
mkdir -p "$dest"
cleanup_dest() { rm -rf "$dest"; }
if ! {
  tar -xzf "$package" -C "$dest" &&
    python3 -m venv "$dest/venv" &&
    "$dest/venv/bin/pip" install --quiet --no-index --find-links "$dest/wheelhouse" emon2influx-parser
}; then
  cleanup_dest
  die "installing $sha failed"
fi

if ! env -i PATH=/usr/bin:/bin "$dest/venv/bin/python" -m emon2influx --check-config --env-file "$ENV_FILE"; then
  cleanup_dest
  echo "$sha $(stat -c %Y "$ENV_FILE" 2>/dev/null)" >"$CONFIG_REJECTED"
  die "release $sha rejects the configuration in $ENV_FILE; fix it and the next run retries"
fi
rm -f "$CONFIG_REJECTED"

previous="$(current_sha)"
refresh_deploy_files "$dest"
switch_to "$sha"

if [ "$mode" = dry-run ]; then
  log "dry run: $sha installed in $dest; no service restarted"
  exit 0
fi

systemctl enable --quiet "$SERVICE"
systemctl restart "$SERVICE"
if reason="$(healthy "$sha")"; then
  log "now running $(json "$manifest" version) ($sha)"
  prune_releases
  exit 0
fi

echo "$sha" >>"$BAD_FILE"
if [ -n "$previous" ] && [ -d "$APP_DIR/releases/$previous" ]; then
  switch_to "$previous"
  systemctl restart "$SERVICE"
  die "release $sha is not healthy ($reason); rolled back to $previous"
fi
die "release $sha is not healthy ($reason) and there is no previous release"
